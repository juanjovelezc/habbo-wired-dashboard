# URL base de la API publica de Habbo. Para el hotel espanol es habbo.es
HABBO_API_BASE=https://www.habbo.es/api/public

# ID de la sala donde esta configurado el Wired (numero, ej. 12345678)
ROOM_ID=

# (Opcional) ID del grupo de la sala para listar sus miembros.
# Si se deja vacio, el panel lo obtiene automaticamente de la sala.
GROUP_ID=

# Clave de LECTURA (X-Wired-Read-Key)
READ_KEY=

# Clave de ESCRITURA (X-Wired-Write-Key)
WRITE_KEY=

# Nombre de la variable que guarda el ID del que clico (definida en el juego)
CLICK_VARIABLE=last_clicker

# Puerto donde se sirve el panel
PORT=3000
